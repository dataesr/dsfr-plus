{
  "name": "@dataesr/dsfr-plus",
  "private": false,
  "version": "0.6.8",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dataesr/dsfr-plus.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/dsfr-plus.es.js",
  "module": "./dist/dsfr-plus.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dsfr-plus.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "example-ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "predeploy": "git switch main && git pull origin main --rebase --tags && git merge origin staging",
    "deploy": "npm version",
    "postdeploy": "git push origin main --tags && git switch staging && git merge origin main && git push",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint --fix 'src/**/*.{jsx,ts,tsx}'",
    "preview": "vite preview",
    "example-ts": "npm run dev -w example-ts"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "react-aria": "^3.53.1",
    "react-polymorphed": "^2.2.2",
    "react-stately": "^3.51.0"
  },
  "peerDependencies": {
    "@gouvfr/dsfr": "^1.15.4",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^5.59.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^8.38.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "remixicon": "^4.9.1",
    "sass": "^1.108.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-libcss": "^1.1.2",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
